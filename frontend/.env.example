# Variables públicas del frontend (prefijo PUBLIC_ para ser accesibles en el
# browser vía $env/dynamic/public).

# Client ID de Google OAuth — el MISMO que GOOGLE_OAUTH_CLIENT_ID del backend.
# Flujo access_token (Google Identity Services): en Google Cloud Console solo
# necesitás crear un OAuth Client ID (tipo Web) y autorizar el origin
# http://localhost:5173. NO hace falta client_secret ni redirect URI.
# Si queda vacío, el botón "Continuar con Google" avisa que no está configurado
# y el login por usuario/contraseña sigue funcionando normalmente.
PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
