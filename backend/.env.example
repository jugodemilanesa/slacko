# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
DATABASE_URL=postgres://slacko:slacko@db:5432/slacko

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM providers
# - Recomendado primario: Gemini (https://aistudio.google.com/apikey)
# - Opcionales fallback: Groq (https://console.groq.com), OpenRouter (https://openrouter.ai/keys)
# Si los tres quedan vacíos, el orquestador cae a modo determinístico (solo wiki).
# Importante: django-environ incluye los caracteres tras `#` como parte del valor.
# No pongas comentarios en la misma línea que la variable.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=                # https://inference.cerebras.ai
SAMBANOVA_API_KEY=               # https://cloud.sambanova.ai
ZAI_API_KEY=                     # https://docs.z.ai (GLM-4.6)
OPENROUTER_API_KEY=

# Overrides de modelo por proveedor (opcional)
# Default actual: gemini/gemini-3.1-flash-lite (rápido y económico, thinking MINIMAL)
# GEMINI_MODEL=gemini/gemini-3.1-flash-lite
# GROQ_MODEL=groq/llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Tuning del orquestador
# LLM_MAX_HOPS=5
# LLM_TEMPERATURE=0.3

# Google OAuth — flujo access_token (GIS). Con el Client ID alcanza; el secret
# queda opcional (no se usa en este flujo). El mismo Client ID va en el frontend
# como PUBLIC_GOOGLE_OAUTH_CLIENT_ID. Autorizá el origin http://localhost:5173.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Frontend (callbacks OAuth y emails de reset)
FRONTEND_BASE_URL=http://localhost:5173
